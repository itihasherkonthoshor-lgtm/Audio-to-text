# Required: Your OpenAI API Key (never commit real keys or put them in the Android APK)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Recommended model: gpt-4o-transcribe (or whisper-1 when verbose segment timestamps are needed)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TIMESTAMP_MODEL=whisper-1
OPENAI_CLEAN_MODEL=gpt-4o-mini

# Optional shared secret token between your Android app (Settings -> Access Token) and this server
API_ACCESS_TOKEN=

# Worker & durability tuning
WORKER_CONCURRENCY=2
MAX_CHUNK_RETRIES=4
OPENAI_TIMEOUT_MS=90000
JOB_DATA_DIR=/var/lib/audiotext-jobs

# Server port
PORT=3000
